{
  "name": "twenty-alibis",
  "version": "0.1.0",
  "private": true,
  "description": "A bilingual murder mystery where every suspect is a Muse Ember agent and code owns the truth.",
  "license": "MIT",
  "author": "Doran Gao",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:redis": "TEST_REDIS_URL=redis://127.0.0.1:6379/15 vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "redis:up": "docker compose up -d --wait",
    "redis:down": "docker compose down",
    "doctor": "node --env-file-if-exists=.env.local --import tsx scripts/doctor.ts",
    "spend": "node --env-file-if-exists=.env.local --import tsx scripts/spend.ts",
    "check:restart": "node --import tsx scripts/restart-check.ts",
    "smoke": "node --env-file-if-exists=.env.local --import tsx scripts/smoke.ts",
    "trial:turn": "node --env-file-if-exists=.env.local --import tsx scripts/turn-trial.ts",
    "play": "node --env-file-if-exists=.env.local --import tsx scripts/play.ts",
    "trial:writer": "node --env-file-if-exists=.env.local --import tsx scripts/write-trial.ts",
    "pilot": "node --env-file-if-exists=.env.local --import tsx scripts/pilot.ts",
    "dev": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite --config vite.config.ts",
    "build:web": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --config vite.config.ts",
    "build:vercel": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true node --import tsx scripts/build-vercel.ts",
    "check:redis-clean": "node --import tsx scripts/redis-clean-check.ts",
    "replay:make": "node --import tsx scripts/make-replay.ts"
  },
  "dependencies": {
    "ioredis": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.1"
  }
}
