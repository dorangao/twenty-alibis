# Copy to .env.local and fill in. .env.local is ignored by git; never commit a real key.

# Meta Model API key. Used only by src/provider/ember.ts, only through the spend guard.
# MUSE_API_KEY or META_API_KEY are accepted too; `npm run doctor` says which one it found.
EMBER_API_KEY=

# The Redis that holds the spend counter. `npm run redis:up` starts one locally.
REDIS_URL=redis://127.0.0.1:6379

# Which budget this process draws from, and its limit in US dollars.
# The limit is fixed in Redis when the envelope is first initialized.
SPEND_ENVELOPE=local
SPEND_LIMIT_USD=

# Set to 1 to refuse every model request.
EMBER_DISABLED=
