      "location": "l-01"
    },
    "means": "m-01",
    "cause": {
      "en": "Found at the foot of the lamp, struck with the winding handle. The lamp room was locked. The lamp had gone out, and in the dark no one in the room could see who struck.",
      "zh": "倒在灯座下，被摇柄击中。灯室当时锁着。当时灯灭了，屋里一片漆黑，在场的人看不见是谁动的手。"
    }
  },
  "means": [
    {
      "id": "m-01",
      "name": {
        "en": "A key to the lamp room",
        "zh": "灯室钥匙"
      }
    }
  ],
  "motives": [
    {
      "id": "mo-01",
      "text": {
        "en": "Stood to lose their post in the inspector's report.",
        "zh": "督察的报告会让此人丢掉职位。"
      }
    },
    {
      "id": "mo-02",
      "text": {
        "en": "Owed the victim money that was due this week.",
        "zh": "欠死者一笔本周到期的钱。"
      }
    },
    {
      "id": "mo-03",
      "text": {
        "en": "Had been refused a share of the salvage.",
        "zh": "打捞所得的分成被拒绝。"
      }
    }
  ],
